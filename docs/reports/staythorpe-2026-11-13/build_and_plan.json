  },
  "firm_capacity_unpublished": {
   "count": 34,
   "message": "LTDS Table 3 gives no firm capacity for this substation: nothing is assumed in its place"
  },
  "forecast_ltds_only": {
   "count": 23,
   "message": "No DFES supply area matches this connection: its LTDS five-year maximum-demand forecast applies (Forecast Year 1 = 2026), then holds"
  },
  "small_embedded_unmodelled": {
   "count": 10,
   "message": "Connected ECR sites under 1 MW that publish no export capacity or no technology are not modelled"
  },
  "small_embedded": {
   "count": 33,
   "message": "Connected ECR sites under 1 MW (most at 0.4 kV) are aggregated per primary and technology at its 11 kV busbar (the model's lowest level), so voltage rise inside the LV network behind it is not modelled; they are added, not netted, because the LTDS minimum demand behaves as gross of generation (no negative minimum in 2,294 rows, ~33-36% even where generation is twice a primary's peak). Domestic rooftop PV is in no register (the ECR and LTDS Table 5 list connections that applied to NGED) and is not modelled"
  },
  "unreachable_demand": {
   "count": 3,
   "message": "Demand on buses the GSP infeed cannot reach in the LTDS connectivity: removed with them, not rescaled onto the rest (the coincidence scaling was applied before): Asfordby Colliery 8.62 MW at ASFY5_MAIN1; Asfordby Colliery 8.62 MW at ASFY5_MAIN2; - 0.14 MW at COGR3PV (total 17.37 MW)"
  },
  "bus_sections_split": {
   "count": 20,
   "message": "EHV busbars of one substation are separate LTDS nodes with no coupler or section circuit between them: the model runs them split, so after a fault a circuit on one bar is not picked up by its pair through the substation (NGED publishes the connectivity, not the running arrangement)"
  },
  "mv_mesh_closed": {
   "count": 9,
   "message": "33 kV circuits that close a loop: LTDS publishes no normal-open points, so the 33 kV network runs as a closed mesh in parallel with the 132 kV and shares its flows"
  }
