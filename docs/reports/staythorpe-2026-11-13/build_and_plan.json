  },
  "normally_open": {
   "count": 1,
   "message": "A circuit run open: the supply point's named normally-open point, inferred from NGED's half-hourly flows (the LTDS publishes connectivity, not the running arrangement)"
  },
  "tap_step_assumed": {
   "count": 40,
